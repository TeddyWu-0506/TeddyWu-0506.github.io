<meta name="author" content="Teddy Wu">
<link rel="canonical" href="https://teddywu.site/">
<meta property="og:type" content="website"><meta property="og:locale" content="zh_CN">
<meta property="og:site_name" content="Teddy Wu"><meta property="og:url" content="https://teddywu.site/">
<meta property="og:title" content="Teddy Wu — AI 产品经理 · 把重复的判断做成能运行的系统">
